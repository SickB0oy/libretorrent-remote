<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <org.proninyaroslav.libretorrent.ui.settings.customprefs.SwitchBarPreference
        android:key="@string/pref_key_streaming_enable"
        android:persistent="false"
        android:summary="@string/pref_enable_streaming"
        app:singleLineTitle="false" />

    <EditTextPreference
        android:dependency="@string/pref_key_streaming_enable"
        android:inputType="text|textNoSuggestions"
        android:key="@string/pref_key_streaming_hostname"
        android:persistent="false"
        android:title="@string/pref_streaming_hostname"
        app:singleLineTitle="false" />

    <EditTextPreference
        android:dependency="@string/pref_key_streaming_enable"
        android:inputType="numberDecimal"
        android:key="@string/pref_key_streaming_port"
        android:persistent="false"
        android:title="@string/pref_streaming_port"
        app:singleLineTitle="false" />

    <org.proninyaroslav.libretorrent.ui.settings.customprefs.SummaryPreference android:summary="@string/pref_streaming_enable_summary" />

    <PreferenceCategory
        android:key="@string/pref_key_remote_category"
        android:title="@string/pref_remote_category">

        <SwitchPreferenceCompat
            android:key="@string/pref_key_remote_enable"
            android:persistent="false"
            android:summary="@string/pref_remote_enable_summary"
            android:title="@string/pref_remote_enable_title"
            app:singleLineTitle="false" />

        <Preference
            android:dependency="@string/pref_key_remote_enable"
            android:key="@string/pref_key_remote_address"
            android:persistent="false"
            android:title="@string/pref_remote_address"
            app:singleLineTitle="false" />

        <EditTextPreference
            android:dependency="@string/pref_key_remote_enable"
            android:inputType="text|textNoSuggestions"
            android:key="@string/pref_key_remote_password"
            android:persistent="false"
            android:title="@string/pref_remote_password"
            app:singleLineTitle="false" />

        <EditTextPreference
            android:dependency="@string/pref_key_remote_enable"
            android:inputType="numberDecimal"
            android:key="@string/pref_key_remote_port"
            android:persistent="false"
            android:title="@string/pref_remote_port"
            app:singleLineTitle="false" />
    </PreferenceCategory>
</PreferenceScreen>